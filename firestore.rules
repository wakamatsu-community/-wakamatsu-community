rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. 認証・ロール判定ヘルパー関数 (B方式)
    // 要件4: Firestore users/{uid}.role を唯一の権限判定元とする。
    // ==========================================

    // 認証済みか (Firebase Authentication トークンを所持)
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // users コレクションにプロファイルが存在するか
    function hasUserDoc() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // users コレクションから role を取得
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // システム管理者 (admin: niina) 判定
    function isAdmin() {
      return hasUserDoc() && getUserRole() == 'admin';
    }

    // 役員 (officer) または システム管理者 (admin) 判定
    function isOfficer() {
      return hasUserDoc() && (getUserRole() == 'officer' || getUserRole() == 'admin');
    }

    // 正当な町内会員 (member, officer, admin) 判定
    function isMember() {
      return hasUserDoc() && (
        getUserRole() == 'member' ||
        getUserRole() == 'officer' ||
        getUserRole() == 'admin'
      );
    }

    // 本人判定
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ==========================================
    // 2. コレクション別アクセス制御ルール (確定仕様: 一般公開 + 登録時認証)
    // ==========================================

    // 1. 会員プロファイル (users)
    // 管理者(admin)専用の特権管理。本人は限定項目のみ更新可能。ロール変更・昇格は管理者のみ
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'phone', 'group', 'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // 2. 町内会公式行事 (events)
    // 閲覧: status == 'published' は一般公開（非会員・未ログイン含む全員）。下書き(draft)は役員以上
    // 作成・変更・削除: 役員・管理者(isOfficer)のみ
    match /events/{eventId} {
      allow read: if (resource.data.status == 'published') || isOfficer();
      allow write: if isOfficer();
    }

    // 3. 会員企画イベント (communityEvents)
    // 閲覧: 承認済み(status == 'approved')は一般公開。承認待ちは企画者本人と役員のみ
    // 企画申請: 認証会員(isMember)のみ。初期statusはpending固定。必須項目と型を強制
    // 更新: 役員、または企画者本人(status=pending固定かつorganizerUid変更禁止)
    // 削除: 役員のみ
    match /communityEvents/{eventId} {
      allow read: if (resource.data.status == 'approved')
                  || (isAuthenticated() && resource.data.organizerUid == request.auth.uid)
                  || isOfficer();
      allow create: if isMember() &&
                    request.resource.data.organizerUid == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.keys().hasAll(['title', 'start', 'place', 'status', 'organizerUid']) &&
                    request.resource.data.keys().hasOnly([
                      'id', 'type', 'title', 'start', 'end', 'place', 'description',
                      'minParticipants', 'maxParticipants', 'status', 'organizerUid',
                      'recruitFormUrl', 'createdAt', 'updatedAt', 'category'
                    ]) &&
                    request.resource.data.title is string && request.resource.data.title.size() > 0 &&
                    request.resource.data.place is string && request.resource.data.place.size() > 0;
      allow update: if isOfficer() ||
                    (isAuthenticated() &&
                     resource.data.organizerUid == request.auth.uid &&
                     request.resource.data.organizerUid == resource.data.organizerUid &&
                     resource.data.status == 'pending' &&
                     request.resource.data.status == 'pending');
      allow delete: if isOfficer();

      // サブコレクション: 参加者台帳 (entries) - 個人情報保護
      // 閲覧: 氏名・電話番号・所属を含むため、責任者(isOfficer)のみ閲覧可。共通会員への他者台帳公開を遮断
      // 参加申込: 認証会員(isMember)のみ。必須項目・型チェック強制
      // 更新・削除: 共通会員による他人の申込改ざん・取消を防止するため、責任者(isOfficer)のみ
      match /entries/{entryId} {
        allow read: if isOfficer();
        allow create: if isMember() &&
                      request.resource.data.uid == request.auth.uid &&
                      request.resource.data.keys().hasAll(['name', 'phone', 'count', 'uid']) &&
                      request.resource.data.keys().hasOnly(['name', 'phone', 'group', 'count', 'uid', 'createdAt', 'type', 'eventId']) &&
                      request.resource.data.name is string && request.resource.data.name.size() > 0 &&
                      request.resource.data.phone is string && request.resource.data.phone.size() > 0 &&
                      request.resource.data.count is int && request.resource.data.count >= 1;
        allow update, delete: if isOfficer();
      }
    }

    // 4. 既存企画アーカイブ (eventPlanning)
    // 役員会での企画検討アーカイブ。役員・管理者のみアクセス可
    match /eventPlanning/{docId} {
      allow read, write: if isOfficer();
    }

    // 5. 回覧板・資料室 (documents)
    // 閲覧: Firebase Authenticationで認証された正規会員(member, officer, admin)のみ閲覧可能。未ログインは閲覧禁止
    // 作成・更新・削除: 役員・管理者(isOfficer)のみ
    match /documents/{docId} {
      allow read: if isMember();
      allow write: if isOfficer();
    }

    // 6. 写真アルバム (photos)
    // 閲覧: 承認済み(status == 'approved')写真は一般公開
    // 投稿申請: 認証会員のみ許可 (status == 'pending' 固定、必須項目チェック)
    // 承認・削除: 役員・管理者のみ
    match /photos/{photoId} {
      allow read: if (resource.data.status == 'approved') || isOfficer();
      allow create: if isMember() &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.userUid == request.auth.uid &&
                    request.resource.data.keys().hasAll(['status', 'userUid']) &&
                    request.resource.data.keys().hasOnly(['title', 'url', 'thumbnailUrl', 'uploaderName', 'comment', 'status', 'userUid', 'createdAt', 'album']);
      allow update, delete: if isOfficer();
    }

    // 7. 備品マスタ (equipmentMaster)
    // 閲覧: 空き状況確認のため一般公開
    // 更新: 役員・管理者のみ
    match /equipmentMaster/{equipmentId} {
      allow read: if true;
      allow write: if isOfficer();
    }

    // 8. 備品予約台帳 (equipmentReservations) - 個人情報保護
    // 閲覧: 氏名・電話番号・組を含むため、責任者(isOfficer)のみ閲覧可。共通会員への他者台帳公開を遮断
    // 予約申請: 認証会員(isMember)のみ許可。userUid偽装禁止、statusはrequested固定、必須項目と型を強制
    // 更新・削除: 共通会員による他人の予約改ざん・取消を防止するため、責任者(isOfficer)のみ許可
    match /equipmentReservations/{reservationId} {
      allow read: if isOfficer();
      allow create: if isMember() &&
                    request.resource.data.userUid == request.auth.uid &&
                    request.resource.data.status == 'requested' &&
                    request.resource.data.keys().hasAll(['equipmentId', 'quantity', 'userUid', 'applicantName', 'phone', 'group', 'status']) &&
                    request.resource.data.keys().hasOnly([
                      'equipmentId', 'equipmentName', 'quantity', 'startDate', 'endDate',
                      'loanDate', 'returnDate', 'userUid', 'applicantName', 'phone', 'group',
                      'status', 'createdAt', 'updatedAt', 'notes'
                    ]) &&
                    request.resource.data.quantity is int && request.resource.data.quantity >= 1 &&
                    request.resource.data.applicantName is string && request.resource.data.applicantName.size() > 0 &&
                    request.resource.data.phone is string && request.resource.data.phone.size() > 0;
      allow update, delete: if isOfficer();
    }

    // 9. 意見交換・相談 (opinions)
    // 閲覧: 公開意見(isPublic == true)は一般公開。非公開相談は役員のみ
    // 投稿: 認証会員(isMember)のみ。初期statusはunconfirmed/pending、userUid偽装禁止
    // 回答記入・ステータス更新・削除: 役員・管理者のみ
    match /opinions/{opinionId} {
      allow read: if (resource.data.isPublic == true) || isOfficer();
      allow create: if isMember() &&
                    request.resource.data.userUid == request.auth.uid &&
                    (request.resource.data.status == 'unconfirmed' || request.resource.data.status == 'pending') &&
                    request.resource.data.keys().hasAll(['category', 'content', 'status', 'userUid']) &&
                    request.resource.data.keys().hasOnly([
                      'name', 'category', 'content', 'photoUrl', 'photoDescription',
                      'status', 'isPublic', 'userUid', 'createdAt', 'updatedAt', 'reply'
                    ]) &&
                    request.resource.data.category is string &&
                    request.resource.data.content is string;
      allow update, delete: if isOfficer();
    }

    // 10. 未定義コレクションは原則拒否 (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
